# Hostinger supplies PORT; normally leave this unset in hPanel.
# PORT=3000
# Optional preview protection. Set BOTH values to enable Basic Authentication.
# Credentials must go in Hostinger environment settings, never in GitHub.
# PREVIEW_USERNAME=khaga-review
# PREVIEW_PASSWORD=replace-with-a-long-unique-password
# New customer purchases remain independently disabled in the deployed Lambda configuration.

# Configure the existing guest frontend only after separate Hostinger release approval.
# Future production value: https://commerce.slavant.com (exact origin, no trailing slash).
# Leave empty now; setting this exposes guest checkout entry links. See docs/commerce-frontend-release.md.
COMMERCE_API_BASE_URL=
