# Hostinger supplies PORT; normally leave this unset in hPanel.
# PORT=3000
# Optional preview protection. Set BOTH values to enable Basic Authentication.
# Credentials must go in Hostinger environment settings, never in GitHub.
# PREVIEW_USERNAME=khaga-review
# PREVIEW_PASSWORD=replace-with-a-long-unique-password
# This preview does not support payments. There is no flag that enables checkout.

# Enable the verified guest AWS API only after Test deployment and API subdomain setup.
# Exact HTTPS origin, no trailing slash. Leave empty to preserve current operation.
COMMERCE_API_BASE_URL=
