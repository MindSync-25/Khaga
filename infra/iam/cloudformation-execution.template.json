{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadPackagedArtifacts",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": "arn:aws:s3:::khaga-prod-artifacts-521199095818-ap-south-1/khaga-commerce-prod/*"
    },
    {
      "Sid": "ManageTwoFunctions",
      "Effect": "Allow",
      "Action": [
        "lambda:CreateFunction",
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration",
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration",
        "lambda:DeleteFunction",
        "lambda:AddPermission",
        "lambda:RemovePermission",
        "lambda:GetPolicy",
        "lambda:ListTags",
        "lambda:TagResource",
        "lambda:UntagResource"
      ],
      "Resource": [
        "arn:aws:lambda:ap-south-1:521199095818:function:khaga-purchase-prod",
        "arn:aws:lambda:ap-south-1:521199095818:function:khaga-confirm-purchase-prod"
      ]
    },
    {
      "Sid": "CreateBoundedRuntimeRoles",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole"
      ],
      "Resource": [
        "arn:aws:iam::521199095818:role/khaga-commerce-prod-PurchaseRole-*",
        "arn:aws:iam::521199095818:role/khaga-commerce-prod-ConfirmPurchaseRole-*"
      ],
      "Condition": {
        "ArnEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::521199095818:policy/khaga-prod-runtime-boundary"
        }
      }
    },
    {
      "Sid": "MaintainRuntimeRoles",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:DeleteRole",
        "iam:GetRolePolicy",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:TagRole",
        "iam:UntagRole"
      ],
      "Resource": [
        "arn:aws:iam::521199095818:role/khaga-commerce-prod-PurchaseRole-*",
        "arn:aws:iam::521199095818:role/khaga-commerce-prod-ConfirmPurchaseRole-*"
      ]
    },
    {
      "Sid": "OnlyBasicLoggingManagedPolicy",
      "Effect": "Allow",
      "Action": [
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy"
      ],
      "Resource": [
        "arn:aws:iam::521199095818:role/khaga-commerce-prod-PurchaseRole-*",
        "arn:aws:iam::521199095818:role/khaga-commerce-prod-ConfirmPurchaseRole-*"
      ],
      "Condition": {
        "ArnEquals": {
          "iam:PolicyARN": "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
        }
      }
    },
    {
      "Sid": "PassOnlyRuntimeRolesToLambda",
      "Effect": "Allow",
      "Action": [
        "iam:PassRole"
      ],
      "Resource": [
        "arn:aws:iam::521199095818:role/khaga-commerce-prod-PurchaseRole-*",
        "arn:aws:iam::521199095818:role/khaga-commerce-prod-ConfirmPurchaseRole-*"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "lambda.amazonaws.com"
        }
      }
    },
    {
      "Sid": "ManageOnlyProdApi",
      "Effect": "Allow",
      "Action": [
        "apigateway:GET",
        "apigateway:PATCH",
        "apigateway:PUT",
        "apigateway:DELETE",
        "apigateway:POST"
      ],
      "Resource": "arn:aws:apigateway:ap-south-1::/apis/REPLACE_WITH_PROD_API_ID"
    },
    {
      "Sid": "ManageOnlyProdStage",
      "Effect": "Allow",
      "Action": [
        "apigateway:GET",
        "apigateway:POST"
      ],
      "Resource": "arn:aws:apigateway:ap-south-1::/apis/REPLACE_WITH_PROD_API_ID/stages"
    },
    {
      "Sid": "ManageDefaultStage",
      "Effect": "Allow",
      "Action": [
        "apigateway:GET",
        "apigateway:PATCH",
        "apigateway:DELETE"
      ],
      "Resource": "arn:aws:apigateway:ap-south-1::/apis/REPLACE_WITH_PROD_API_ID/stages/$default"
    },
    {
      "Sid": "ManageProdLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:DeleteLogGroup",
        "logs:PutRetentionPolicy",
        "logs:DeleteRetentionPolicy",
        "logs:TagResource",
        "logs:UntagResource",
        "logs:ListTagsForResource"
      ],
      "Resource": [
        "arn:aws:logs:ap-south-1:521199095818:log-group:/aws/lambda/khaga-purchase-prod",
        "arn:aws:logs:ap-south-1:521199095818:log-group:/aws/lambda/khaga-confirm-purchase-prod",
        "arn:aws:logs:ap-south-1:521199095818:log-group:/aws/lambda/khaga-purchase-prod:*",
        "arn:aws:logs:ap-south-1:521199095818:log-group:/aws/lambda/khaga-confirm-purchase-prod:*"
      ]
    },
    {
      "Sid": "ReadLogGroupMetadata",
      "Effect": "Allow",
      "Action": [
        "logs:DescribeLogGroups"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-south-1"
        }
      }
    },
    {
      "Sid": "TagOnlyProdApiAndStage",
      "Effect": "Allow",
      "Action": [
        "apigateway:GET",
        "apigateway:PUT",
        "apigateway:POST",
        "apigateway:PATCH",
        "apigateway:DELETE"
      ],
      "Resource": [
        "arn:aws:apigateway:ap-south-1::/tags/arn:aws:apigateway:ap-south-1::/apis/REPLACE_WITH_PROD_API_ID",
        "arn:aws:apigateway:ap-south-1::/tags/arn%3Aaws%3Aapigateway%3Aap-south-1%3A%3A%2Fapis%2FREPLACE_WITH_PROD_API_ID",
        "arn:aws:apigateway:ap-south-1::/tags/arn:aws:apigateway:ap-south-1::/apis/REPLACE_WITH_PROD_API_ID/stages/$default",
        "arn:aws:apigateway:ap-south-1::/tags/arn%3Aaws%3Aapigateway%3Aap-south-1%3A%3A%2Fapis%2FREPLACE_WITH_PROD_API_ID%2Fstages%2F%24default",
        "arn:aws:apigateway:ap-south-1::/tags/arn:aws:apigateway:ap-south-1::/v2/apis/REPLACE_WITH_PROD_API_ID",
        "arn:aws:apigateway:ap-south-1::/tags/arn%3Aaws%3Aapigateway%3Aap-south-1%3A%3A%2Fv2%2Fapis%2FREPLACE_WITH_PROD_API_ID",
        "arn:aws:apigateway:ap-south-1::/tags/arn:aws:apigateway:ap-south-1::/v2/apis/REPLACE_WITH_PROD_API_ID/stages/$default",
        "arn:aws:apigateway:ap-south-1::/tags/arn%3Aaws%3Aapigateway%3Aap-south-1%3A%3A%2Fv2%2Fapis%2FREPLACE_WITH_PROD_API_ID%2Fstages%2F%24default"
      ]
    },
    {
      "Sid": "UseSamTransform",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateChangeSet"
      ],
      "Resource": "arn:aws:cloudformation:ap-south-1:aws:transform/Serverless-2016-10-31"
    }
  ]
}
