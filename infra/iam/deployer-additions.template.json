{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PrepareTestChangeSet",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateChangeSet"
      ],
      "Resource": "arn:aws:cloudformation:ap-south-1:521199095818:stack/khaga-commerce-test/*",
      "Condition": {
        "ArnEquals": {
          "cloudformation:RoleArn": "arn:aws:iam::521199095818:role/khaga-test-cloudformation"
        }
      }
    },
    {
      "Sid": "UseSamTransform",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateChangeSet"
      ],
      "Resource": "arn:aws:cloudformation:ap-south-1:aws:transform/Serverless-2016-10-31"
    },
    {
      "Sid": "ReviewAndExecuteTestChangeSet",
      "Effect": "Allow",
      "Action": [
        "cloudformation:DescribeStacks",
        "cloudformation:DescribeStackEvents",
        "cloudformation:DescribeStackResources",
        "cloudformation:ListStackResources",
        "cloudformation:GetTemplate",
        "cloudformation:DescribeChangeSet",
        "cloudformation:ListChangeSets",
        "cloudformation:ExecuteChangeSet",
        "cloudformation:DeleteChangeSet"
      ],
      "Resource": "arn:aws:cloudformation:ap-south-1:521199095818:stack/khaga-commerce-test/*"
    },
    {
      "Sid": "PassOnlyTestCloudFormationRole",
      "Effect": "Allow",
      "Action": [
        "iam:PassRole"
      ],
      "Resource": "arn:aws:iam::521199095818:role/khaga-test-cloudformation",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "cloudformation.amazonaws.com"
        }
      }
    },
    {
      "Sid": "InspectArtifactBucket",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::khaga-test-artifacts-521199095818-ap-south-1"
    },
    {
      "Sid": "ListOnlyArtifactPrefix",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::khaga-test-artifacts-521199095818-ap-south-1",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "khaga-commerce-test",
            "khaga-commerce-test/*"
          ]
        }
      }
    },
    {
      "Sid": "UploadTestArtifacts",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:AbortMultipartUpload"
      ],
      "Resource": "arn:aws:s3:::khaga-test-artifacts-521199095818-ap-south-1/khaga-commerce-test/*"
    },
    {
      "Sid": "CheckSecretMetadataOnly",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:DescribeSecret"
      ],
      "Resource": "REPLACE_WITH_TEST_SECRET_ARN"
    },
    {
      "Sid": "ReadTestFunctionMetadata",
      "Effect": "Allow",
      "Action": [
        "lambda:GetFunctionConfiguration"
      ],
      "Resource": [
        "arn:aws:lambda:ap-south-1:521199095818:function:khaga-purchase-test",
        "arn:aws:lambda:ap-south-1:521199095818:function:khaga-confirm-purchase-test"
      ]
    },
    {
      "Sid": "FirstPaymentCheckOnPurchase",
      "Effect": "Allow",
      "Action": [
        "lambda:InvokeFunction"
      ],
      "Resource": "arn:aws:lambda:ap-south-1:521199095818:function:khaga-purchase-test"
    },
    {
      "Sid": "ReadTestLogs",
      "Effect": "Allow",
      "Action": [
        "logs:DescribeLogStreams",
        "logs:FilterLogEvents"
      ],
      "Resource": [
        "arn:aws:logs:ap-south-1:521199095818:log-group:/aws/lambda/khaga-purchase-test:*",
        "arn:aws:logs:ap-south-1:521199095818:log-group:/aws/lambda/khaga-confirm-purchase-test:*"
      ]
    },
    {
      "Sid": "ReadTestLogEvents",
      "Effect": "Allow",
      "Action": [
        "logs:GetLogEvents"
      ],
      "Resource": [
        "arn:aws:logs:ap-south-1:521199095818:log-group:/aws/lambda/khaga-purchase-test:log-stream:*",
        "arn:aws:logs:ap-south-1:521199095818:log-group:/aws/lambda/khaga-confirm-purchase-test:log-stream:*"
      ]
    },
    {
      "Sid": "ReadTestApi",
      "Effect": "Allow",
      "Action": [
        "apigateway:GET"
      ],
      "Resource": [
        "arn:aws:apigateway:ap-south-1::/apis/REPLACE_WITH_TEST_API_ID",
        "arn:aws:apigateway:ap-south-1::/apis/REPLACE_WITH_TEST_API_ID/stages",
        "arn:aws:apigateway:ap-south-1::/apis/REPLACE_WITH_TEST_API_ID/stages/$default"
      ]
    }
  ]
}
