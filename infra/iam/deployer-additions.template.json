{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PrepareProdChangeSet",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateChangeSet"
      ],
      "Resource": "arn:aws:cloudformation:ap-south-1:521199095818:stack/khaga-commerce-prod/*",
      "Condition": {
        "ArnEquals": {
          "cloudformation:RoleArn": "arn:aws:iam::521199095818:role/khaga-prod-cloudformation"
        }
      }
    },
    {
      "Sid": "UseSamTransform",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateChangeSet"
      ],
      "Resource": "arn:aws:cloudformation:ap-south-1:aws:transform/Serverless-2016-10-31"
    },
    {
      "Sid": "ReviewAndExecuteProdChangeSet",
      "Effect": "Allow",
      "Action": [
        "cloudformation:DescribeStacks",
        "cloudformation:DescribeStackEvents",
        "cloudformation:DescribeStackResources",
        "cloudformation:ListStackResources",
        "cloudformation:GetTemplate",
        "cloudformation:DescribeChangeSet",
        "cloudformation:ListChangeSets",
        "cloudformation:ExecuteChangeSet",
        "cloudformation:DeleteChangeSet"
      ],
      "Resource": "arn:aws:cloudformation:ap-south-1:521199095818:stack/khaga-commerce-prod/*"
    },
    {
      "Sid": "PassOnlyProdCloudFormationRole",
      "Effect": "Allow",
      "Action": [
        "iam:PassRole"
      ],
      "Resource": "arn:aws:iam::521199095818:role/khaga-prod-cloudformation",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "cloudformation.amazonaws.com"
        }
      }
    },
    {
      "Sid": "InspectArtifactBucket",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::khaga-prod-artifacts-521199095818-ap-south-1"
    },
    {
      "Sid": "ListOnlyArtifactPrefix",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::khaga-prod-artifacts-521199095818-ap-south-1",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "khaga-commerce-prod",
            "khaga-commerce-prod/*"
          ]
        }
      }
    },
    {
      "Sid": "UploadProdArtifacts",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:AbortMultipartUpload"
      ],
      "Resource": "arn:aws:s3:::khaga-prod-artifacts-521199095818-ap-south-1/khaga-commerce-prod/*"
    },
    {
      "Sid": "CheckSecretMetadataOnly",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:DescribeSecret"
      ],
      "Resource": "REPLACE_WITH_PROD_SECRET_ARN"
    },
    {
      "Sid": "ReadProdFunctionMetadata",
      "Effect": "Allow",
      "Action": [
        "lambda:GetFunctionConfiguration"
      ],
      "Resource": [
        "arn:aws:lambda:ap-south-1:521199095818:function:khaga-purchase-prod",
        "arn:aws:lambda:ap-south-1:521199095818:function:khaga-confirm-purchase-prod"
      ]
    },
    {
      "Sid": "FirstPaymentCheckOnPurchase",
      "Effect": "Allow",
      "Action": [
        "lambda:InvokeFunction"
      ],
      "Resource": "arn:aws:lambda:ap-south-1:521199095818:function:khaga-purchase-prod"
    },
    {
      "Sid": "ReadProdLogs",
      "Effect": "Allow",
      "Action": [
        "logs:DescribeLogStreams",
        "logs:FilterLogEvents"
      ],
      "Resource": [
        "arn:aws:logs:ap-south-1:521199095818:log-group:/aws/lambda/khaga-purchase-prod:*",
        "arn:aws:logs:ap-south-1:521199095818:log-group:/aws/lambda/khaga-confirm-purchase-prod:*"
      ]
    },
    {
      "Sid": "ReadProdLogEvents",
      "Effect": "Allow",
      "Action": [
        "logs:GetLogEvents"
      ],
      "Resource": [
        "arn:aws:logs:ap-south-1:521199095818:log-group:/aws/lambda/khaga-purchase-prod:log-stream:*",
        "arn:aws:logs:ap-south-1:521199095818:log-group:/aws/lambda/khaga-confirm-purchase-prod:log-stream:*"
      ]
    },
    {
      "Sid": "ReadProdApi",
      "Effect": "Allow",
      "Action": [
        "apigateway:GET"
      ],
      "Resource": [
        "arn:aws:apigateway:ap-south-1::/apis/REPLACE_WITH_PROD_API_ID",
        "arn:aws:apigateway:ap-south-1::/apis/REPLACE_WITH_PROD_API_ID/stages",
        "arn:aws:apigateway:ap-south-1::/apis/REPLACE_WITH_PROD_API_ID/stages/$default"
      ]
    }
  ]
}
