{
  "name": "khaga-storefront",
  "version": "0.3.0",
  "private": true,
  "description": "KHAGA Collection 001 \u2014 deployable, read-only commerce preview",
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "node scripts/build-client.mjs && node --watch server.mjs",
    "build": "node scripts/build-client.mjs && node scripts/build.mjs",
    "start": "node server.mjs",
    "test": "node scripts/build-client.mjs && node --test test/*.test.mjs",
    "check": "npm test && npm run build",
    "prestart": "node scripts/build-client.mjs"
  }
}
